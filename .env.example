# ============================================================
# Server
# ============================================================
PORT=3000
NODE_ENV=production
# Origin dashboard yang diizinkan (pisahkan dengan koma). Kosong = semua origin.
CORS_ORIGIN=
# Jumlah proxy di depan app (Nginx = 1). Dipakai untuk membaca IP asli.
TRUST_PROXY=loopback
LOG_LEVEL=info

# ============================================================
# Database (MySQL / MariaDB) - wajib untuk dashboard
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=whatsapp_api
MYSQL_USER=root
MYSQL_PASSWORD=
# Buat tabel yang belum ada saat server start (tidak menghapus data)
DB_AUTO_SYNC=true

# ============================================================
# Login dashboard (JWT) - WAJIB diisi string acak panjang
#   openssl rand -hex 48
# ============================================================
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ============================================================
# WhatsApp
# ============================================================
# Tempat kredensial sesi WhatsApp: file | mysql
AUTH_STORE=file
# Folder sesi bila AUTH_STORE=file (default: src/auth)
AUTH_DIR=
# false = jalankan API tanpa membuka koneksi WhatsApp (development / test)
WHATSAPP_ENABLED=true
# Jalankan ulang sesi yang sudah tertaut saat server start
RESTORE_SESSIONS_ON_START_UP=true
CLIENT_PLATFORM=Whatsapp MD
CLIENT_BROWSER=Chrome
CLIENT_VERSION=4.0.0
MARK_MESSAGES_READ=false
# Nomor berawalan 0 diganti kode negara ini (kosongkan untuk mematikan)
DEFAULT_COUNTRY_CODE=62
# Reconnect otomatis per sesi (tidak mengganggu sesi lain). 0 = tanpa batas percobaan.
WA_RECONNECT_BASE_MS=1000
WA_RECONNECT_MAX_MS=300000
WA_RECONNECT_MAX_ATTEMPTS=0

# ============================================================
# Media (gambar, video, stiker, audio/voice note, dokumen)
# ============================================================
# Folder penyimpanan file media. Kosong = src/media
MEDIA_DIR=
# Batas ukuran media yang diunduh dari pesan masuk (MB)
MEDIA_MAX_MB=25
# Rahasia tanda tangan URL media (kosong = memakai JWT_SECRET)
MEDIA_TOKEN_SECRET=
# Batas unduhan /mediaurl (MB) dan timeout
MEDIA_URL_MAX_MB=25
MEDIA_URL_TIMEOUT_MS=15000
# Host yang boleh diunduh /mediaurl (pisahkan koma; kosong = semua host publik)
MEDIA_URL_ALLOWED_HOSTS=

# ============================================================
# API kirim pesan untuk aplikasi lain: /api/message/*?key=<instance_key>
# Jika PROTECT_ROUTES=true, wajib header "Authorization: Bearer <TOKEN>"
# ============================================================
PROTECT_ROUTES=false
TOKEN=

# ============================================================
# Webhook keluar (opsional).
# Webhook PER DEVICE diatur dari dashboard (Devices -> Edit) dan
# selalu mengirim event messages + connection.
# WEBHOOK_URL di bawah hanya fallback untuk device tanpa webhook sendiri.
# Event webhook global: all, messages, connection
# ============================================================
WEBHOOK_URL=
WEBHOOK_ALLOWED_EVENTS=all
# Batas waktu request webhook (ms)
WEBHOOK_TIMEOUT_MS=5000
# Secret default untuk header X-Signature (dipakai bila device tanpa webhook_secret)
WEBHOOK_SECRET=
# true = sertakan instance_key di payload (perilaku lama, TIDAK disarankan)
WEBHOOK_INCLUDE_KEY=false

# ============================================================
# Antrean pesan keluar / anti-ban (POST /api/message/queue*)
# Jeda & kuota dihitung PER DEVICE. 0 = tanpa batas.
# Panduan: QUEUE.md
# ============================================================
QUEUE_ENABLED=true
QUEUE_POLL_MS=1000
QUEUE_MIN_DELAY_MS=8000
QUEUE_MAX_DELAY_MS=25000
QUEUE_HOURLY_LIMIT=60
QUEUE_DAILY_LIMIT=200
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_BASE_MS=30000
QUEUE_RETRY_MAX_MS=900000
QUEUE_BATCH_MAX=100
# Jam kirim lokal, mis. 8-21. Kosong / 0-24 = sepanjang hari.
QUEUE_ACTIVE_HOURS=
QUEUE_TIMEZONE=Asia/Jakarta
# Simulasi "sedang mengetik" sebelum mengirim (lebih natural, sedikit lebih lambat).
QUEUE_TYPING=false
QUEUE_TYPING_MAX_MS=4000
