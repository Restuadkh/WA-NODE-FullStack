# ============================================================
# Server
# ============================================================
PORT=3000
NODE_ENV=production
# Origin dashboard yang diizinkan (pisahkan dengan koma). Kosong = semua origin.
CORS_ORIGIN=
# Jumlah proxy di depan app (Nginx = 1). Dipakai untuk membaca IP asli.
TRUST_PROXY=loopback
LOG_LEVEL=info

# ============================================================
# Database (MySQL / MariaDB) - wajib untuk dashboard
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=whatsapp_api
MYSQL_USER=root
MYSQL_PASSWORD=
# Buat tabel yang belum ada saat server start (tidak menghapus data)
DB_AUTO_SYNC=true
# Dialek database: mysql (default) atau sqlite (development/test; butuh npm i sqlite3)
# Bila sqlite: DB_DIALECT=sqlite dan DB_STORAGE=data.sqlite
DB_DIALECT=mysql

# ============================================================
# Login dashboard (JWT) - WAJIB diisi string acak panjang
#   openssl rand -hex 48
# ============================================================
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ============================================================
# WhatsApp
# ============================================================
# Folder kredensial sesi WhatsApp (default: src/auth)
AUTH_DIR=
# false = jalankan API tanpa membuka koneksi WhatsApp (development / test)
WHATSAPP_ENABLED=true
# Jalankan ulang sesi yang sudah tertaut saat server start
RESTORE_SESSIONS_ON_START_UP=true
# true = pesan masuk otomatis ditandai terbaca
MARK_MESSAGES_READ=false
# false = membuka chat di dashboard TIDAK mengirim centang biru
SEND_READ_RECEIPTS=true
# Nomor berawalan 0 diganti kode negara ini (kosongkan untuk mematikan)
DEFAULT_COUNTRY_CODE=62
# Reconnect otomatis per sesi (tidak mengganggu sesi lain). 0 = tanpa batas percobaan.
WA_RECONNECT_BASE_MS=1000
WA_RECONNECT_MAX_MS=300000
WA_RECONNECT_MAX_ATTEMPTS=0
# Saat tombol Tautkan / endpoint QR membuka device offline: retry otomatis dibatasi
# N percobaan (jeda 2 detik antar percobaan), setelah itu berhenti (cooldown 60 detik).
# 0 = reconnect healing tanpa batas.
DEVICE_QR_START_ATTEMPTS=3

# ============================================================
# Media (gambar, video, stiker, audio/voice note, dokumen)
# ============================================================
# Folder penyimpanan file media. Kosong = src/media
MEDIA_DIR=
# Batas ukuran media: upload multipart (/api/message/*, Inbox) DAN unduhan pesan masuk (MB).
MEDIA_MAX_MB=50
# Rahasia tanda tangan URL media (kosong = memakai JWT_SECRET)
MEDIA_TOKEN_SECRET=
# Masa berlaku URL media (jam). URL diperbarui otomatis setiap inbox dibuka.
MEDIA_URL_EXPIRY_HOURS=168

# ============================================================
# API kirim pesan untuk aplikasi lain: /api/message/*
#   Header "X-Api-Key: <instance_key>" (disarankan).
#   PROTECT_ROUTES=true menambah syarat "Authorization: Bearer <TOKEN>".
#   GATEWAY_RATE_LIMIT_PER_MINUTE = batas request/menit per IP (0 = tanpa batas).
# ============================================================
PROTECT_ROUTES=false
TOKEN=
# false = key TIDAK boleh lewat query string ?key= (lebih aman; header saja)
GATEWAY_ALLOW_QUERY_KEY=true
GATEWAY_RATE_LIMIT_PER_MINUTE=120

# ============================================================
# Formulir kontak publik (/api/contact)
# ============================================================
# Folder penyimpanan pesan masuk (default: src/data/contact). Jangan taruh di frontend/public.
CONTACT_DIR=

# ============================================================
# Webhook keluar (opsional).
# Webhook PER DEVICE diatur dari dashboard (Devices -> Edit) dan
# selalu mengirim event messages + message.update + connection.
# WEBHOOK_URL di bawah hanya fallback untuk device tanpa webhook sendiri.
# Event webhook global: all, messages, message.update, connection
# ============================================================
WEBHOOK_URL=
WEBHOOK_ALLOWED_EVENTS=all
# Batas waktu request webhook (ms)
WEBHOOK_TIMEOUT_MS=5000
# Secret default untuk header X-Signature (HMAC-SHA256 body)
WEBHOOK_SECRET=
# true = sertakan instance_key di payload (perilaku lama, TIDAK disarankan)
WEBHOOK_INCLUDE_KEY=false
