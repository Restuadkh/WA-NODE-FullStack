{
  "name": "wa-dashboard-backend",
  "version": "2.4.0",
  "description": "WhatsApp gateway + dashboard backend (Baileys, Express, Sequelize, socket.io)",
  "main": "src/server.js",
  "private": true,
  "author": "Restuadkh",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:sync": "node src/scripts/syncDb.js",
    "db:reset": "node src/scripts/syncDb.js --force",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:user": "node src/scripts/seedUser.js",
    "test": "node --test test",
    "db:upgrade": "node src/scripts/dbUpgrade.js",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev",
    "build:frontend": "npm --prefix frontend ci && npm --prefix frontend run build"
  },
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Restuadkh/WA-NODE-FullStack.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "sqlite3": "^6.0.1"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "protobufjs@7.6.5": true,
    "sqlite3@6.0.1": true
  }
}
