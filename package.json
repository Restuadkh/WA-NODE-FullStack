{
  "name": "wa-dashboard-backend",
  "version": "2.0.0",
  "description": "WhatsApp gateway + dashboard backend (Baileys, Express, Sequelize, socket.io)",
  "main": "src/server.js",
  "private": true,
  "author": "",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
