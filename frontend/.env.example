# Dipakai oleh dev server Vite (proxy). Arahkan ke backend Node.js Anda.
BACKEND_URL=http://localhost:3000

# Dipakai saat build production jika frontend dan backend beda domain.
# Kosongkan jika frontend disajikan dari domain yang sama dengan backend (via Nginx).
# Contoh: VITE_API_URL=https://wa.example.com
VITE_API_URL=
